# ------------------------------------------------------------------
# Monster Burguer - exemplo de variaveis de ambiente
# Copie este arquivo para .env e ajuste os valores:
#   cp .env.example .env
# O arquivo .env NUNCA vai para o repositorio (ja esta no .gitignore).
# ------------------------------------------------------------------

# Ambiente: development | test | production
NODE_ENV=development

# Porta do servidor HTTP
PORT=3000

# Caminho do arquivo do banco SQLite
DB_PATH=./data/monster-burguer.db

# Segredo usado para assinar os tokens JWT (gere um aleatorio!)
# Sugestao: openssl rand -hex 32
JWT_SECRET=troque-por-um-segredo-aleatorio-bem-grande

# Tempo de validade do token de login
JWT_EXPIRES_IN=1d

# Administrador inicial (dono da loja), criado automaticamente no boot.
# Deixe ADMIN_CPF vazio para NAO criar nenhum admin automaticamente.
ADMIN_NOME=Wagner (Dono)
ADMIN_CPF=11144477735
ADMIN_SENHA=monster123
